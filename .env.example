# Nakili faili hii kuwa .env kisha ujaze thamani zako kutoka Firebase Console
# (Project Settings → General → Your apps → SDK setup and configuration)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Baada ya kudeploy Cloud Functions (firebase deploy --only functions),
# Firebase itakupa URL kama: https://us-central1-<project-id>.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=
